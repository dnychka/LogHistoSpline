library(ggplot2)
ggplot(dataLattice, aes(x = Y, y = X)) +       # X ~ Y means X on the vertical axis
geom_point(shape = 1, colour = "lightblue") +
facet_wrap(~ cases, nrow = 3, ncol = 2) +
# as.table = FALSE fills panels bottom-up, like lattice
theme_bw() +
theme(panel.spacing = unit(0, "lines"),
# panels touch, like lattice
strip.background = element_rect(fill = "grey80"))
library(ggplot2)
ggplot(dataLattice, aes(x = Y, y = X)) +
geom_point(shape = 1, colour = "#0080ff" ) +
facet_wrap(~ cases, nrow = 3, ncol = 2) +
theme_bw() +
theme(panel.spacing = unit(0, "lines"),
strip.background = element_rect(fill = "grey80"))
